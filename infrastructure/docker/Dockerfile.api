FROM python:3.11-slim as builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.11-slim

WORKDIR /app

# Create non-root security user
RUN groupadd -r predictx && useradd -r -g predictx -d /app -s /sbin/nologin predictx

COPY --from=builder /root/.local /home/predictx/.local
ENV PATH=/home/predictx/.local/bin:$PATH
ENV PYTHONPATH=/app

COPY . /app
RUN chown -R predictx:predictx /app

USER predictx

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "apps.api.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
